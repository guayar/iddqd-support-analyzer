# Optional modules are enabled in the Config tab (default: Analyze only).
# After changing checkboxes, click Restart application and refresh the browser.

# Local Ollama. Used only when Assistant / General Chat is enabled.
# OLLAMA_MODEL is any pulled tag (exact string from `ollama list`). The UI shows this
# value; it is not read from the weight file. If unset, the process default is qwen3.6:27b.
# Tested tag: qwen3.6:27b on AMD Radeon AI PRO R9700.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.6:27b
ALLOW_REMOTE_LLM=false
APP_PORT=7860
MAX_FILE_MB=150

# General Chat web search (separate from private Analyzer/Assistant)
WEB_SEARCH_RESULTS=6
WEB_FETCH_RESULTS=3
WEB_FETCH_CHARS=16000
WEB_SEARCH_REGION=wt-wt
# auto = all ddgs text engines. Or a comma list:
# brave,duckduckgo,google,grokipedia,mojeek,startpage,wikipedia,yahoo
WEB_SEARCH_BACKEND=auto

# Assistant screenshots (local only; never sent to General Chat / web search)
ASSISTANT_IMAGE_MAX_MB=8
ASSISTANT_IMAGE_MAX_PIXELS=12000000
ASSISTANT_IMAGES_PER_MESSAGE=3
OCR_TIMEOUT_SECONDS=5

# Optional second layer of UI authentication
# BASIC_AUTH_USER=
# BASIC_AUTH_PASS=
